BOT_TOKEN=replace-with-botfather-token
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deutschiq
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WEBAPP_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true

# Local development: polling. Cloud Run: webhook.
BOT_MODE=polling
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_16_or_more_random_characters
TASK_SECRET=replace-with-at-least-24-random-characters
